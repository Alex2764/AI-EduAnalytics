# Backend environment variables
# Copy to .env in this folder and fill in real values. Do not commit .env.

# ============================================
# REQUIRED
# ============================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Alternative to SUPABASE_ANON_KEY (e.g. service role — keep secret):
# SUPABASE_KEY=
# Service role — lets teacher UI read submissions if RLS blocks anon (recommended):
# SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini ([Google AI Studio](https://aistudio.google.com/app/apikey))
GEMINI_API_KEY=your-gemini-api-key-here
# Optional override, e.g. gemini-2.0-flash (auto-detected if omitted)
# GEMINI_MODEL=

# Groq — stage 1 analysis draft ([console.groq.com](https://console.groq.com))
GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# OPTIONAL
# ============================================

# HOST=0.0.0.0
# PORT=8000
# ENVIRONMENT=development
# ENABLE_DOCS=true
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# CLEANUP_API_KEY=
# USE_SUPABASE_STORAGE=false
# SUPABASE_STORAGE_BUCKET=templates
# LOG_LEVEL=INFO
