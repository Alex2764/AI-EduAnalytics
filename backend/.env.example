# Backend environment variables
# Copy to .env in this folder and fill in real values. Do not commit .env.

# ============================================
# REQUIRED
# ============================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Alternative to SUPABASE_ANON_KEY (e.g. service role — keep secret):
# SUPABASE_KEY=

# AI: set ONE provider and its key (see backend README)
# Options: gemini | groq
AI_PROVIDER=gemini

# If AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# Optional override, e.g. gemini-1.5-flash
# GEMINI_MODEL=

# If AI_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key-here
# Optional override (default in app: llama-3.3-70b-versatile)
# GROQ_MODEL=

# ============================================
# OPTIONAL
# ============================================

# HOST=0.0.0.0
# PORT=8000
# ENVIRONMENT=development
# ENABLE_DOCS=true
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# CLEANUP_API_KEY=
# USE_SUPABASE_STORAGE=false
# SUPABASE_STORAGE_BUCKET=templates
# LOG_LEVEL=INFO
